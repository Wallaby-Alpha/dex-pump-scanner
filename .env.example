# DEX Pump Scanner Configuration

# 1. Telegram Bot Settings
# Obtain TELEGRAM_BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Obtain TELEGRAM_CHAT_ID (User ID or Channel/Group ID, e.g. -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=

# 2. Scanner Thresholds
MIN_LIQUIDITY_USD=10000
MIN_SCORE_ALERT=55
VOL_SURGE_THRESHOLD=2.5
BUY_RATIO_THRESHOLD=0.65

# 3. Chains to Monitor (comma-separated: solana, robinhood, base, bsc, ethereum, arbitrum)
TARGET_CHAINS=solana,robinhood,base,bsc,ethereum

# 4. Scanner Polling Timing
POLL_INTERVAL_SECONDS=30
ALERT_COOLDOWN_MINUTES=120
