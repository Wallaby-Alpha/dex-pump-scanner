# DEX Pre-Breakout Scanner Configuration

# 1. Telegram Dispatch Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Chains to Monitor (comma-separated: solana, robinhood, bsc, base, ethereum)
TARGET_CHAINS=solana,robinhood,bsc,base,ethereum

# 3. Scanner Polling Timing
POLL_INTERVAL_SECONDS=30
ALERT_COOLDOWN_MINUTES=120
MIN_SCORE_ALERT=60

# 4. Climax Top / Exhaustion Guard
MAX_ALLOWED_1H_CHANGE_PCT=35.0
CLIMAX_EXCEPTION_FLOAT_RATIO=60.0
MAX_ALLOWED_5M_CHANGE_PCT=15.0

# 5. Profile A: Robinhood & BSC Deep-Float Compounders
MIN_FLOAT_RATIO_EVM=20.0
MAX_FDV_EVM=350000
MIN_BUY_RATIO_EVM=0.55
MIN_LIQUIDITY_USD=10000

# 6. Profile B: Solana High-Velocity Breakouts
MIN_VOL_1H_SOLANA=100000
MIN_TXNS_SOLANA=2500
MIN_BUY_RATIO_SOLANA=0.75
MIN_FLOAT_RATIO_SOLANA=10.0
MAX_FLOAT_RATIO_SOLANA=22.0
MIN_FDV_SOLANA=100000
MAX_FDV_SOLANA=500000
MIN_LIQUIDITY_SOLANA_USD=30000
